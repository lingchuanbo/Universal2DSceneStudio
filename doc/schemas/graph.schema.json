{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VFXForge Graph",
  "type": "object",
  "required": [
    "schema_version",
    "graph_id",
    "nodes",
    "connections"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "graph_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "node-instance.schema.json"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_node",
          "from_socket",
          "to_node",
          "to_socket"
        ],
        "properties": {
          "from_node": {
            "type": "string"
          },
          "from_socket": {
            "type": "string"
          },
          "to_node": {
            "type": "string"
          },
          "to_socket": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}