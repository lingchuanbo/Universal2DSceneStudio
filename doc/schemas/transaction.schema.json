{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VFXForge Transaction",
  "type": "object",
  "required": [
    "transaction_id",
    "project_id",
    "expected_revision",
    "operations",
    "risk_level"
  ],
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "destructive"
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "requires_approval": {
      "type": "boolean"
    },
    "preview_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}