{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfxforge.local/schemas/ai-task-record.schema.json",
  "title": "VFXForge AI Task Record",
  "description": "Non-secret audit metadata for one AI planning/edit attempt. Provider credentials and raw prompt payloads are deliberately excluded from this persisted record schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "project_id", "created_utc", "status", "intent_summary", "base_revision", "provider_id", "model_id", "patch_id", "result"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["planned", "preview_ready", "awaiting_approval", "applied", "rejected", "canceled", "failed", "stale_revision"]},
    "intent_summary": {"type": "string", "maxLength": 2000},
    "context_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "base_revision": {"type": "integer", "minimum": 0},
    "applied_revision": {"type": ["integer", "null"], "minimum": 0},
    "provider_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "endpoint_kind": {"enum": ["known_provider", "openai_compatible", "local"]},
    "data_shared": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["project_summary", "selected_graph", "node_descriptors", "diagnostics", "preview_image", "asset_metadata"]}
    },
    "patch_id": {"type": ["string", "null"]},
    "patch_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "approval": {"enum": ["not_required_read_only", "approved", "rejected", "not_reached"]},
    "transaction_id": {"type": ["string", "null"]},
    "undo_transaction_id": {"type": ["string", "null"]},
    "duration_ms": {"type": "integer", "minimum": 0},
    "error_code": {"type": ["string", "null"]},
    "result": {"enum": ["no_change", "applied", "rejected", "canceled", "failed", "stale_revision"]},
    "extension_data": {"type": "object"}
  }
}
