{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VFXForge Node Instance",
  "type": "object",
  "required": [
    "node_id",
    "type_id",
    "version",
    "position",
    "parameters"
  ],
  "properties": {
    "node_id": {
      "type": "string"
    },
    "type_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "parameters": {
      "type": "object"
    },
    "ui_state": {
      "type": "object"
    }
  }
}